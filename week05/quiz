<!DOCTYPE html>
<html lang="en-US">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HTML and CSS Quiz | WDD 130</title>
    <meta name="description" content="Test your knowledge of HTML and CSS with this short quiz.">
    <meta name="author" content="Manuel Alejandro Colmenares Alarcón">
    <link rel="stylesheet" href="../styles/quiz.css">
</head>

<body>
    <header>
        <h1>HTML and CSS Quiz</h1>
    </header>

    <main>
        <form>
            <div class="form-item">
                <label for="q1">1. What does HTML stand for?</label>
                <input type="text" id="q1" name="q1">
            </div>

            <div class="form-item">
                <label for="q2">2. Explain the purpose of CSS in a web page.</label>
                <textarea id="q2" name="q2" rows="4"></textarea>
            </div>

            <div class="form-item">
                <label for="q3">3. Which HTML element is used to create a hyperlink?</label>
                <select id="q3" name="q3">
                    <option value="" selected disabled>Choose One ...</option>
                    <option value="img">&lt;img&gt;</option>
                    <option value="a">&lt;a&gt;</option>
                    <option value="p">&lt;p&gt;</option>
                </select>
            </div>

            <div class="form-item">
                <label for="q4">4. How many heading levels are available in HTML?</label>
                <input type="number" id="q4" name="q4" step="1">
            </div>

            <button type="submit">Submit Quiz</button>
        </form>
    </main>
</body>

</html>
